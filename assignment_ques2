# Write a function that takes two integers and prints all even numbers between them (inclusive).

def even_no(first_no, second_no):
    for i in range(first_no,second_no+1):
        if(i%2==0):
            print(i)

first_no= int(input("ENTER YOUR FIRST NUMBER"))
second_no= int(input("ENTER THE SECOND NUMBER"))

even_no(first_no, second_no)

