# Write a program to print all numbers from 1 to 100 that are divisible by both 3 and 5

for i in range(1,101):
    if i%3==0 and i%5==0:
        print(i)

# Design a program to continuously input a number from user & print if it is positive or negative 
# until the user enters “Quit”.

while True:
    n= input("ENTER YOUR NUMBER (QUIT TO EXIT): ")

    if n== "OUIT":
        break

    n= int(n)

    if n>0:
        print("POSITIVE")
    elif n<0:
        print("NEGATIVE")
    else:
        print("ZERO")
